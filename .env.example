# ─────────────────────────────────────────────────────────────
# Makhtout — Variables d'environnement production
# Copier ce fichier vers .env et remplir les valeurs secrètes.
# ─────────────────────────────────────────────────────────────

# Base de données
DATABASE_URL=postgresql://makhtout:makhtout_secret@postgres:5432/makhtout_db
POSTGRES_USER=makhtout
POSTGRES_PASSWORD=__MOT_DE_PASSE_FORT__
POSTGRES_DB=makhtout_db

# Cache & files
REDIS_URL=redis://redis:6379/0

# Stockage objet (MinIO)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=makhtout
MINIO_SECRET_KEY=__MOT_DE_PASSE_FORT__
MINIO_BUCKET=documents
MINIO_ROOT_USER=makhtout
MINIO_ROOT_PASSWORD=__MOT_DE_PASSE_FORT__

# Sécurité JWT
SECRET_KEY=__CLE_ALEATOIRE_32_CARACTERES_MIN__
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# URLs publiques
FRONTEND_URL=https://makhtout.pro
NEXT_PUBLIC_API_URL=https://makhtout.pro
NEXT_PUBLIC_APP_URL=https://makhtout.pro
NEXT_PUBLIC_APP_NAME=Makhtout

# Admin initial (utilisé par le service init)
ADMIN_EMAIL=admin@makhtout.pro
ADMIN_PASSWORD=__MOT_DE_PASSE_ADMIN_FORT__

# Paiements — laisser vide en développement
CHARGILY_API_KEY=
CHARGILY_SECRET=
CHARGILY_BASE_URL=https://pay.chargily.net/test/api/v2

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
