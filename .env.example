# ─────────────────────────────────────────────────────────────
# Makhtout — Variables d'environnement
# Copier ce fichier vers .env et remplir les valeurs secrètes.
# ─────────────────────────────────────────────────────────────

# Base de données
DATABASE_URL=postgresql://makhtout:makhtout_secret@postgres:5432/makhtout_db
POSTGRES_USER=makhtout
POSTGRES_PASSWORD=makhtout_secret
POSTGRES_DB=makhtout_db

# Cache & files
REDIS_URL=redis://redis:6379/0

# Stockage objet (MinIO)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=makhtout
MINIO_SECRET_KEY=makhtout_secret
MINIO_BUCKET=documents
MINIO_ROOT_USER=makhtout
MINIO_ROOT_PASSWORD=makhtout_secret

# Sécurité JWT
SECRET_KEY=super_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# URLs publiques
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Makhtout

# Paiements — laisser vide en développement
CHARGILY_API_KEY=
CHARGILY_SECRET=
CHARGILY_BASE_URL=https://pay.chargily.net/test/api/v2

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
